{
  "name": "proton-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Local PowerShell automation for Proton Mail Bridge",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "proton-mail-bridge-client": "2.1.49"
  },
  "scripts": {
    "check:powershell": "pwsh -NoLogo -NoProfile -Command \"Get-ChildItem scripts -Filter *.ps1 | ForEach-Object { [void][scriptblock]::Create((Get-Content -Raw -LiteralPath $_.FullName)) }; Write-Host 'PowerShell syntax OK'\"",
    "doctor": "pwsh -NoLogo -NoProfile -File scripts/Invoke-ProtonMail.ps1 doctor --json",
    "inbox": "pwsh -NoLogo -NoProfile -File scripts/Get-ProtonMail.ps1",
    "inbox:triage": "pwsh -NoLogo -NoProfile -File scripts/Get-ProtonInboxTriage.ps1",
    "inbox:proposals": "pwsh -NoLogo -NoProfile -File scripts/Get-ProtonMailActionProposals.ps1",
    "inbox:worksheet": "pwsh -NoLogo -NoProfile -File scripts/New-ProtonMailDecisionWorksheet.ps1",
    "desk": "pwsh -NoLogo -NoProfile -File scripts/Start-ProtonMailDesk.ps1",
    "mcp": "pwsh -NoLogo -NoProfile -File scripts/Start-ProtonMcp.ps1"
  }
}
